---
const projects = [
  {
    title: "Embedded Motion Control Robot",
    description:
      "A project exploring motor control, encoder feedback, and PID.",
  },
  {
    title: "Patient Management System",
    description:
      "A web application with medical records and report generation.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Paing Myo Thaw's software and robotics portfolio."
    />
    <title>Paing Myo Thaw | Portfolio</title>
  </head>

  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <section id="about">
        <p class="label">Software · Embedded Systems · Robotics</p>
        <h1>Hi, I'm Paing Myo Thaw.</h1>
        <p>
          I am a Computer Science student interested in building
          intelligent robotic systems.
        </p>
      </section>

      <section id="projects">
        <h2>My projects</h2>

        <div class="projects">
          {projects.map((project) => (
            <article>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>
          <a href="mailto:paingmyothaw04328@gmail.com">Email me</a>
          ·
          <a href="https://github.com/PaingMyoThaw">GitHub</a>
        </p>
      </section>
    </main>

    <footer>© {new Date().getFullYear()} Paing Myo Thaw</footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #111827;
    color: #e5e7eb;
    font-family: Arial, sans-serif;
    line-height: 1.7;
  }

  header,
  main,
  footer {
    max-width: 1000px;
    margin: auto;
    padding: 24px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  a {
    color: #93c5fd;
  }

  a:focus-visible {
    outline: 2px solid #93c5fd;
    outline-offset: 5px;
  }

  section {
    padding: 48px 0;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.2;
  }

  .label {
    color: #93c5fd;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }

  article {
    padding: 24px;
    border: 1px solid #374151;
    border-radius: 12px;
    background: #1f2937;
  }

  footer {
    color: #9ca3af;
  }
</style>
