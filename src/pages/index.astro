---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/project";
---

<BaseLayout>
  <Header />

  <main>
    <section id="about">
      <p class="label">Software · Embedded Systems · Robotics</p>
      <h1>Hi, I'm Paing Myo Thaw.</h1>
      <p>
        I am a Computer Science student interested in building
        intelligent robotic systems.
      </p>
    </section>

    <section id="projects">
      <h2>My projects</h2>

      <div class="projects">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
          />
        ))}
      </div>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <a href="mailto:paingmyothaw04328@gmail.com">Email me</a>
      <a href="https://github.com/PaingMyoThaw">GitHub</a>
    </section>
  </main>

  <Footer />
</BaseLayout>