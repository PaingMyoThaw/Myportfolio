---
import { sitePath } from "../utils/paths";

interface Props {
  homeLinks?: boolean;
}

const { homeLinks = false } = Astro.props;
const homeHref = homeLinks ? sitePath() : "";
---

<header class="site-header">
  <nav class="container navigation" aria-label="Main navigation">
    <a class="brand" href={`${homeHref}#about`} aria-label="Paing's portfolio home">
      <span aria-hidden="true">&gt;_</span> paing<span class="brand-path">@robo</span>
    </a>

    <div class="nav-links">
      <a href={`${homeHref}#about`}>~/about</a>
      <a href={`${homeHref}#projects`}>~/projects</a>
      <a href={`${homeHref}#skills`}>~/skills</a>
      <a href={`${homeHref}#contact`}>~/contact</a>
    </div>
  </nav>
</header>
